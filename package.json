{
  "name": "universal-escrow-protocol",
  "version": "1.0.0",
  "description": "Reusable escrow contracts, SDK, and MCP server",
  "main": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/createServer.d.ts",
      "import": "./dist/mcp/createServer.js"
    }
  },
  "files": [
    "dist/sdk",
    "dist/mcp",
    "README.md"
  ],
  "scripts": {
    "build": "hardhat build && tsc && npm run build:docs",
    "build:docs": "vite build --config web/vite.config.ts",
    "dev:docs": "vite --config web/vite.config.ts --host 127.0.0.1",
    "preview:docs": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:docs": "tsc --noEmit -p web/tsconfig.json",
    "test": "hardhat test",
    "deploy:local": "hardhat build && node scripts/deploy-local.mjs",
    "mcp": "node dist/mcp/server.js",
    "demo:freelance": "hardhat run apps/freelance/demo.ts",
    "demo:p2p": "hardhat run apps/p2p/demo.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.20.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ethers": "^6.17.0",
    "zod": "^4.6.7"
  }
}
