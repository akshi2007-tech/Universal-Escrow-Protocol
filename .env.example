# Local RPC endpoint. Start it with: npx hardhat node --network hardhatMainnet
ESCROW_RPC_URL=http://127.0.0.1:8545
ESCROW_CHAIN_NAME=hardhat-local
ESCROW_CHAIN_ID=31337

# Replace with a local development account key printed by the local node.
# Never use a real wallet key here.
ESCROW_PRIVATE_KEY=0x<local-development-private-key>
ESCROW_CONTRACT_ADDRESS=0x<deployed-escrow-address>
ESCROW_ENABLE_WRITE_TOOLS=false

# Optional public token configuration, for example {"mUSDC":{"address":"0x...","decimals":6}}
ESCROW_TOKEN_CONFIG_JSON={}

# Optional testnet variables for the existing Hardhat network configuration.
SEPOLIA_RPC_URL=https://<sepolia-rpc-provider>
SEPOLIA_PRIVATE_KEY=0x<sepolia-testnet-private-key>

# Public browser configuration for the already-deployed Sepolia reference.
# VITE_ values are included in the browser bundle. Use a public/read-only RPC URL;
# never put private keys, credentials, or secret RPC tokens in these variables.
VITE_ESCROW_RPC_URL=
VITE_ESCROW_CONTRACT_ADDRESS=0x8BFF30EcA3b4FF87d269B086525161ab334F04b7
VITE_MUSDC_ADDRESS=0xE52bFe7d7e08Fe268a6413f77676c96a17577fcb
